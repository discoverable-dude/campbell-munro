# Public site URL, no trailing slash. Used for canonical URLs, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://campbellmunro.co.uk

# Search engines are blocked everywhere until this is "true". Set it on the Vercel
# Production environment only, at launch (after photos are licensed and placeholders replaced).
ALLOW_INDEXING=false

# Resend (https://resend.com). The sending domain must be verified in Resend.
RESEND_API_KEY=
# Where enquiries are delivered. Comma separate for more than one address.
CONTACT_TO_EMAIL=enquiries@campbellmunro.co.uk
# Must be on a domain verified in Resend, e.g. "Campbell Munro Website <website@campbellmunro.co.uk>"
CONTACT_FROM_EMAIL=Campbell Munro Website <website@campbellmunro.co.uk>
